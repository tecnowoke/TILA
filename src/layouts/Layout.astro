---
import Navbar from '../pages/Navbar.astro';
import Footer from '../pages/Footer.astro';
import Wh from '../components/Wh.astro';
import '../styles/global.css'; // Aquí importás tu CSS externo
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />

    <!-- Fuentes locales -->
    <style>
      @font-face {
        font-family: 'BeathanyEllingston';
        src: url('/fonts/BeathanyEllingston.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
      }
    </style>
  </head>
  <body>
    <Navbar />
    <slot />
    <Wh />
    <Footer />
  </body>
</html>
