---
// src/pages/Tila.astro
import Layout from "../layouts/Layout.astro";
import styles from "../styles/tila.module.css";
import Tarjeta from "../components/Tarjeta.astro";
import terapeutas from "../data/Nosotros.ts";   //  ← sin extensión y en minúsculas
---
<Layout>
  <section class={styles.container}>
    <section class={styles.titleSection}>
      <h1>¿QUIÉNES SOMOS?</h1>
    </section>

    <section class={styles.terapeutas}>
      {terapeutas.map((t, i) => (
        <Tarjeta
          index={i} 
          nombre={t.nombre}
          bajada={t.bajada}
          texto={t.texto}
          imagen={t.imagen}
          instagram={t.instagram}
          facebook={t.facebook}
          mail={t.mail}
        />
      ))}
    </section>
  </section>
</Layout>
