---
import IconosRedes from '../components/IconosRedes.jsx';
const email = "contacto@tilasalud.com";
---

<style>
  footer {
    color: var(--Tila_Negro_80);
  
    padding: 2rem 60px;
    text-align: left;
  }
  footer h2 {
    margin: 0rem;
    font-size: 2rem;
    font-family: var(--font-Tila-NavBar, 'Bebas Neue', sans-serif);
      font-weight: lighter;
  }
  p.email {
    font-weight: 500;
    font-size: 1.5rem;
    margin: 0;
    padding: 1rem 0 2rem 0;
  }


</style>

<footer>
  <h2>Contacto</h2>
  <p class="email">{email}</p>
    <IconosRedes client:load />

</footer>
