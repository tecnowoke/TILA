---
import IconosRedes from '../components/IconosRedes.jsx';
const email = "contacto@tilasalud.com";
---

<style>
  footer {
    background-color: var(--primary-color, #8B5E3B);
    color: white;
    padding: 2rem 1rem;
    text-align: center;
  }
  footer h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  p.email {
    font-weight: 500;
    font-size: 1rem;
    margin: 0;
  }
</style>

<footer>
  <h2>Contacto</h2>
  <IconosRedes client:load />
  <p class="email">{email}</p>
</footer>
