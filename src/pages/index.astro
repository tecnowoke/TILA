---
import styles from "../styles/home.module.css";
import Layout from "../layouts/Layout.astro";
import FormacionesBloque from '../components/FormacionesBloque.astro';
import WorkshopsBloque from '../components/WorkshopsBloque.astro';
import TestimoniosBloque from "../components/TestimoniosBloque.astro";
import Slider from "./Slider.astro";
import Vector2 from '../assets/vectors/Vector2.svg';
import Vector1 from '../assets/vectors/Vector1.svg';
import Vector6 from '../assets/vectors/Vector6.svg';


const slides = [
  {
    title: 'Anuncio TILA Sembrar Salud',
    subtitle: 'Un subtítulo que establezca el contexto, ofrezca más información sobre el sitio web o, en general, anime a los usuarios a seguir desplazándose.',
    buttonText: 'Ver más',
    buttonLink: '/pagina1'
  },
  {
    title: 'Título 2',
    subtitle: 'Esta es la bajada o descripción del slide 2',
    buttonText: 'Comprar',
    buttonLink: '/pagina2'
  },
  {
    title: 'Título 3',
    subtitle: 'Esta es la bajada o descripción del slide 3',
    buttonText: 'Contactar',
    buttonLink: '/pagina3'
  }
];

const base = import.meta.env.BASE_URL;
---


<Layout>
  <section class={styles.home}>
  <section class={styles.tilaSection}>
    <h1 class={styles.titulo}>TILA</h1>
    <h2 class={styles.slogan}>
    Sembrar Salud
    </h2>
    <p class={styles.subtitulo}>Un subtítulo que establezca el contexto, ofrezca más información sobre el sitio web o, en general, anime a los usuarios a seguir desplazándose.</p>
        <img 
        id="rotating-image" 
        src={Vector2.src} 
        alt="Decoración TILA" 
        class={styles.Vector1} 
      />
  </section>

   <section class={styles.section}>
  <!-- Carrusel -->
<Slider slides={slides} />

</section>

<section class={styles.animatedSection}>
    <div class={styles.decoSection}>

    <img 
        id="growing-image" 
        src={Vector6.src} 
        alt="Decoración TILA" 
        class={styles.Vector2} 
      />
      </div>
  <p class={styles.animatedText}>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque in justo venenatis, congue orci at, viverra felis. Suspendisse dignissim  vulputate finibus. Aliquam nec ex nisi. Sed suscipit, nulla eu luctus  commodo, lacus justo dapibus odio, eu faucibus tortor felis at mi. Duis  in mollis ligula, eu vulputate odio. </p>
  <div class={styles.decoSection}>
     <img 
        id="rotating90-image" 
        src={Vector1.src} 
        alt="Decoración TILA" 
        class={styles.Vector3} 
      />
    </div>  
 
</section>

<section id="formaciones">
  <FormacionesBloque />
</section>

<section id="workshops">
  <WorkshopsBloque />
</section>
<TestimoniosBloque/>


<!-- Importar el archivo JS, asegurándote de que la ruta sea correcta -->
<script type="module" src="/scripts/actualizarJSON.js"></script>

    <script>
   document.addEventListener('DOMContentLoaded', () => {
  const rotatingImage = document.getElementById('rotating-image'); // Vector2
  const rotating90Image = document.getElementById('rotating90-image'); // Vector1
  const growingImage = document.getElementById('growing-image'); // Vector6

  // Rango de scroll para la animación (en px)
  const animationRange = 300;

  window.addEventListener('scroll', () => {
    const viewportHeight = window.innerHeight;

    // Función para calcular progreso entre 0 y 1 según posición del elemento
    function getScrollProgress(el) {
      const rect = el.getBoundingClientRect();
      // Cuando el elemento está justo entrando por abajo viewport, progress=0
      // Cuando el elemento sube 'animationRange' px dentro del viewport, progress=1
      const progress = 1 - (rect.top / animationRange);
      return Math.min(Math.max(progress, 0), 1); // clamp entre 0 y 1
    }

    // 1. Rotación continua para rotatingImage (Vector2)
    // Aquí puedes mantener rotación libre o sincronizar con scroll relativo
    // Por ejemplo, rotación proporcional al scroll total:
    const scrollY = window.scrollY;
    rotatingImage.style.transform = `rotate(${scrollY * 0.1}deg)`;

    // 2. Rotación progresiva 0° a 90° para rotating90Image (Vector1)
    let progressRot90 = getScrollProgress(rotating90Image);
    let rotation90 = progressRot90 * 180;
    rotating90Image.style.transform = `rotate(${rotation45}deg)`;

    // 3. Crecer y disolver growingImage (Vector6)
    let progressGrow = getScrollProgress(growingImage);
    let scale = 1 + progressGrow * 0.5; // escala 1 a 1.5
    let opacity = 1 - progressGrow;      // opacidad 1 a 0
    growingImage.style.transform = `scale(${scale})`;
    growingImage.style.opacity = opacity;
  });
});


    </script>
  </section>
</Layout>

