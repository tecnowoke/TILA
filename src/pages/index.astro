---
import styles from "../styles/home.module.css";
import Layout from "../layouts/Layout.astro";
import FormacionesBloque from '../components/FormacionesBloque.astro';
import WorkshopsBloque from '../components/WorkshopsBloque.astro';
import UsBloque from '../components/UsBloque.astro';
import TestimoniosBloque from "../components/TestimoniosBloque.astro";
import Slider from "./Slider.astro";
import Vector1 from '../assets/vectors/Vector1.png';

const slides = [
  {
    title: 'Título 1',
    subtitle: 'Esta es la bajada o descripción del slide 1',
    buttonText: 'Ver más',
    buttonLink: '/pagina1'
  },
  {
    title: 'Título 2',
    subtitle: 'Esta es la bajada o descripción del slide 2',
    buttonText: 'Comprar',
    buttonLink: '/pagina2'
  },
  {
    title: 'Título 3',
    subtitle: 'Esta es la bajada o descripción del slide 3',
    buttonText: 'Contactar',
    buttonLink: '/pagina3'
  }
];

const base = import.meta.env.BASE_URL;
---


<Layout>
  <section class={styles.home}>
  <section class={styles.tilaSection}>
    <h1 class={styles.titulo}>TILA</h1>
    <h2 class={styles.slogan}>
    Sembrar Salud
    </h2>
    <p class={styles.subtitulo}>Un subtítulo que establezca el contexto, ofrezca más información sobre el sitio web o, en general, anime a los usuarios a seguir desplazándose.</p>
      <img src={Vector1.src} alt="Decoración TILA" class={styles.Vector1} />
  </section>

   <section class={styles.section}>
  <!-- Carrusel -->
<Slider slides={slides} />

</section>

<section>
  <p class={styles.animatedText}>Cuerpo de texto para lo que quieras decir. Añade puntos principales, citas, anécdotas. Cuerpo de texto para lo que quieras añadir más al punto principal. Proporciona detalles, explicaciones y contexto. Cuerpo de texto para lo que quieras añadir más al punto principal. Proporciona detalles. Cuerpo de texto para lo que quieras que quieras añadir al punto principal.</p>
</section>

<FormacionesBloque/>
<WorkshopsBloque/>
<UsBloque/>
<TestimoniosBloque/>


<!-- Importar el archivo JS, asegurándote de que la ruta sea correcta -->
<script type="module" src="/scripts/actualizarJSON.js"></script>
  </section>
</Layout>

