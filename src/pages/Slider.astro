---
import styles from '../styles/slider.module.css';
const { slides = [] } = Astro.props;
---

<div class={styles.slider} id="slider">
  <div class={styles.slides} id="slides" style="transform: translateX(0%)">
    {slides.map((slide, i) => (
      <div class={styles.slide} key={i}>
        <p>{slide.subtitle}</p>
        <h2>{slide.title}</h2>
        <a href={slide.buttonLink} class={styles.button}>{slide.buttonText}</a>
      </div>
    ))}
  </div>
  <section class={styles.pieDeCarrousel}>
    
  <div class={styles.pagination} id="pagination">
    {slides.map((_, i) => (
      <button
        aria-label={`Go to slide ${i + 1}`}
        data-index={i}
        class={i === 0 ? `${styles.paginationButton} ${styles.paginationButtonActive}` : styles.paginationButton}
        key={i}
      ></button>
    ))}
  </div>
  <section class={styles.arrowSection}>
    <button aria-label="Previous Slide" class={`${styles.navArrow} ${styles.navPrev}`} id="prevBtn">&#10094;</button>
    <button aria-label="Next Slide" class={`${styles.navArrow} ${styles.navNext}`} id="nextBtn">&#10095;</button>
  </section>

</section>

</div>

<script is:inline>
  const slidesEl = document.getElementById('slides');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const pagination = document.getElementById('pagination');
  const dots = Array.from(pagination.querySelectorAll('button'));

  let currentIndex = 0;
  const totalSlides = dots.length;

  function updateSlider() {
    slidesEl.style.transform = `translateX(-${currentIndex * 100}%)`;
    dots.forEach((dot, i) => {
      dot.classList.toggle('${styles.paginationButtonActive}', i === currentIndex);
    });
  }

  prevBtn.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    updateSlider();
  });

  nextBtn.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateSlider();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const index = Number(e.target.dataset.index);
      if (!isNaN(index)) {
        currentIndex = index;
        updateSlider();
      }
    });
  });
</script>
