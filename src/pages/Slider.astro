---
const { slides = [] } = Astro.props;

// Para manejar estado y lógica usaremos JS nativo en <script> del cliente
---

<style>
  .slider {
    position: relative;
    max-width: 600px;
    margin: auto;
    overflow: hidden;
    background: #222;
    border-radius: 8px;
    color: white;
    font-family: sans-serif;
  }

  .slides {
    display: flex;
    transition: transform 0.4s ease-in-out;
    will-change: transform;
  }

  .slide {
    min-width: 100%;
    padding: 2rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .slide h2 {
    margin: 0 0 0.5rem;
  }

  .slide p {
    margin: 0 0 1.5rem;
    opacity: 0.8;
  }

  .slide a.button {
    align-self: flex-start;
    background: #2563eb;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(37, 99, 235, 0.8);
    border: none;
    color: white;
    font-size: 2rem;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
    border-radius: 50%;
    user-select: none;
    transition: background 0.3s;
  }
  .nav-arrow:hover {
    background: #1e40af;
  }
  .nav-arrow:focus {
    outline: 2px solid #93c5fd;
  }

  .nav-prev {
    left: 10px;
  }

  .nav-next {
    right: 10px;
  }

  .pagination {
    text-align: center;
    padding: 1rem 0.5rem;
  }

  .pagination button {
    background: #444;
    border: none;
    width: 12px;
    height: 12px;
    margin: 0 6px;
    border-radius: 50%;
    cursor: pointer;
  }

  .pagination button.active,
  .pagination button:hover {
    background: #2563eb;
  }
</style>

<div class="slider" id="slider">
  <div class="slides" id="slides" style="transform: translateX(0%)">
    {slides.map((slide: { title: unknown; subtitle: unknown; buttonLink: string | URL | null | undefined; buttonText: unknown; }) => (
      <div class="slide">
        <h2>{slide.title}</h2>
        <p>{slide.subtitle}</p>
        <a href={slide.buttonLink} class="button">{slide.buttonText}</a>
      </div>
    ))}
  </div>

  <button aria-label="Previous Slide" class="nav-arrow nav-prev" id="prevBtn">&#10094;</button>
  <button aria-label="Next Slide" class="nav-arrow nav-next" id="nextBtn">&#10095;</button>

  <div class="pagination" id="pagination">
    {slides.map((_: any, i: unknown) => (
      <button aria-label={`Go to slide ${i + 1}`} data-index={i} class={i === 0 ? 'active' : ''}></button>
    ))}
  </div>
</div>

<script is:inline>
  const slidesEl = document.getElementById('slides');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const pagination = document.getElementById('pagination');
  const dots = Array.from(pagination.querySelectorAll('button'));

  let currentIndex = 0;
  const totalSlides = dots.length;

  function updateSlider() {
    slidesEl.style.transform = `translateX(-${currentIndex * 100}%)`;
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === currentIndex);
    });
  }

  prevBtn.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    updateSlider();
  });

  nextBtn.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateSlider();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const index = Number(e.target.dataset.index);
      if (!isNaN(index)) {
        currentIndex = index;
        updateSlider();
      }
    });
  });
</script>
