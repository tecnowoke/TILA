---
import styles from '../styles/slider.module.css';
import ButtonTila from "../components/Button.astro";

const { slides = [] } = Astro.props;
---

<div class={styles.slider} id="slider">
  <div class={styles.slides} id="slides" style="transform: translateX(0%)">
    {slides.map((slide, i) => (
    <div
      class={styles.slide}
      key={i}
      style={`background-image: url('${slide.img}'); background-size: cover; background-position: center;`}
    >
      <div class={styles.slideOverlay}>
        <p>{slide.subtitle}</p>
        <h2>{slide.title}</h2>
        <ButtonTila
          variant="negro"
          href={slide.buttonLink}
          class={styles.btnComprar}
        >
          {slide.buttonText}
        </ButtonTila>
      </div>
    </div>
  ))}
  </div>

  <section class={styles.pieDeCarrousel}>
    <div class={styles.pagination} id="pagination">
      {slides.map((_, i) => (
        <button
          type="button"
          aria-label={`Go to slide ${i + 1}`}
          data-index={i}
          class={i === 0 ? `${styles.paginationButton} ${styles.paginationButtonActive}` : styles.paginationButton}
          key={i}
        ></button>
      ))}
    </div>

    <section class={styles.arrowSection}>
      <!-- Flecha anterior (rotada) -->
      <button type="button" class={`${styles.navArrow}`} id="prevBtn" aria-label="Anterior">
        <svg class={`${styles.arrowIcon} ${styles.left}`} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 16H30M30 16L16 2M30 16L16 30"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round" />
        </svg>
      </button>

      <!-- Flecha siguiente -->
      <button type="button" class={`${styles.navArrow}`} id="nextBtn" aria-label="Siguiente">
        <svg class={styles.arrowIcon} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 16H30M30 16L16 2M30 16L16 30"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round" />
        </svg>
      </button>
    </section>
  </section>
</div>

<script is:inline>
  const slidesEl = document.getElementById('slides');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const pagination = document.getElementById('pagination');
  const dots = Array.from(pagination.querySelectorAll('button'));

  let currentIndex = 0;
  const totalSlides = dots.length;

  function updateSlider() {
    slidesEl.style.transform = `translateX(-${currentIndex * 100}%)`;
    dots.forEach((dot, i) => {
      dot.classList.toggle(styles.paginationButtonActive, i === currentIndex);
    });
  }

  prevBtn.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    updateSlider();
  });

  nextBtn.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateSlider();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const index = Number(e.target.dataset.index);
      if (!isNaN(index)) {
        currentIndex = index;
        updateSlider();
      }
    });
  });
</script>
