---
import Layout from "../layouts/Layout.astro";
import styles from "../styles/formaciones.module.css";
import { formaciones } from "../data/formaciones.js";
---

<Layout>
  <section class={styles.container}>
    {formaciones.map((formacion) => (
      <article key={formacion.id} class={styles.formacionCard}>
        <h2>{formacion.nombre}</h2>
        <h3>{formacion.subtitulo}</h3>
        <p>{formacion.descripcion}</p>
        <p><strong>Modalidad:</strong> {formacion.modalidad}</p>
        <p><strong>Precio:</strong> {formacion.precio}</p>
        <p><strong>Formas de pago:</strong> {formacion.formasPago}</p>
        <a href={formacion.link} class={styles.infoLink}>+ INFORMACIÓN</a>
      </article>
    ))}
  </section>  
</Layout>
