---
const base = import.meta.env.BASE_URL;
---

<nav style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; background-color: #002d42; color: white; font-family: 'Literata', serif;">
  <!-- Logo / Marca -->
  <div style="font-size: 1.5rem; font-weight: bold;">
    <a href={base} style="color: white; text-decoration: none;">TILA</a>
  </div>

  <!-- Navegación -->
  <ul style="list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0;">
    <li><a href={base} style="color: white; text-decoration: none;">Inicio</a></li>
    <li><a href={`${base}tila`} style="color: white; text-decoration: none;">Quienes somos</a></li>
    <li><a href={`${base}formaciones`} style="color: white; text-decoration: none;">Formaciones</a></li>
    <li><a href={`${base}workshops`} style="color: white; text-decoration: none;">Talleres</a></li>
    <li><a href={`${base}terapeutas`} style="color: white; text-decoration: none;">Terapeutas</a></li>
    <li><a href={`${base}blog`} style="color: white; text-decoration: none;">Blog</a></li>
  </ul>
</nav>
