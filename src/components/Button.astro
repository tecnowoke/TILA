---
/* No destructures `children`; usa <slot /> */
const { href = "#", variant = "primary" } = Astro.props;
---
<a href={href} class={`button ${variant}`}>
  <slot />   <!-- el contenido del botón -->
</a>

<style>
  .button {
    display: inline-block;
    border-radius: 4px;
    height: fit-content;
    padding: 15px 20px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  /* variante por defecto */
  .button.primary {
    color: var(--Tila_Blanco_100);
    font-family: 'Futura Std', sans-serif;
      font-weight: lighter;
      border-radius: 30px;

  }

    .button.primary:hover {
    color: var(--Tila_Blanco_100);
    background-color: var(--Tila_Verde_100);

  }
  

  /* variante dorada */
  .button.dorado {
    background: var(--Tila_Dorado_100);
    color: var(--Tila_Negro_100);
    border: none;
    font-family: var(--font-Tila-NavBar, 'Bebas Neue', sans-serif);
    letter-spacing: 1.6px;
  }
  .button.dorado:hover {
    color: var(--Tila_Blanco_100);
    background-color: var(--Tila_Verde_100);
  }

   .button.negro {
    background: none;
    color: var(--Tila_Negro_80);
    border: 1px solid ;
    border-radius: 180px;
    height: fit-content;
    width: fit-content;
    padding:  10px 35px;
    font-family: var(--font-Tila-NavBar, 'Bebas Neue', sans-serif);
    letter-spacing: 1.6px;
  }

     .button.negro:hover {
    color: var(--Tila_Blanco_100);
    background-color: var(--Tila_Verde_100);
    border:  var(--Tila_Verde_100);
  }
</style>
