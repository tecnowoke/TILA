---
/* No destructures `children`; usa <slot /> */
const { href = "#", variant = "primary" } = Astro.props;
---
<a href={href} class={`button ${variant}`}>
  <slot />   <!-- el contenido del botón -->
</a>

<style>
  .button {
    display: inline-block;
    border-radius: 4px;
    font-weight: 600;
    height: fit-content;
    padding: 5px 10px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  /* variante por defecto */
  .button.primary {
    background: #2563eb;
    color: #fff;
  }

  /* variante dorada */
  .button.dorado {
    background: var(--Tila_Dorado_100);
    color: var(--Tila_Negro_100);
    border: none;
  }
</style>
