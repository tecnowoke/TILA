---
const { href = "#", variant = "primary", children } = Astro.props;
---
<a href={href} class={`button ${variant}`}>
  {children}
</a>

<style>
.button {
  display: inline-block;
  padding: 0.5rem 1.2rem;
  border-radius: 4px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}

/* Estilo prediseñado: primary */
.button.basico {
  background: #2563eb;
  color: #fff;
}

/* Estilo prediseñado: secondary */
.button.dorado {
  background: #fff;
  color: #2563eb;
  border: 2px solid #2563eb;
}

/* Puedes agregar más variantes aquí */
</style>
