---
/* No destructures `children`; usa <slot /> */
const { href = "#", variant = "primary" } = Astro.props;
---
<a href={href} class={`button ${variant}`}>
  <slot />   <!-- el contenido del botón -->
</a>

<style>
  .button {
    display: inline-block;
    border-radius: 4px;
    font-weight: 600;
    height: fit-content;
    padding: 15px 20px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  /* variante por defecto */
  .button.primary {
    color: var(--Tila_Blanco_100);
    font-family: 'Futura Std', sans-serif;
      font-weight: lighter;
      border-radius: 30px;
  }

    .button.primary:hover {
    color: var(--Tila_Blanco_100);
    background-color: var(--Tila_Verde_100);

  }

  /* variante dorada */
  .button.dorado {
    background: var(--Tila_Dorado_100);
    color: var(--Tila_Negro_100);
    border: none;
  }
</style>
