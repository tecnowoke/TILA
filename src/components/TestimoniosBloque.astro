---
const testimonios = [
  {
    nombre: "Nombre 1",
    testimonio: "Me encantó buenisimo todo, hermoso laburo."
  },
  {
    nombre: "Nombre 2",
    testimonio: "Otro ejemplo de testimonio escrito."
  }
];
---

<style>
  section {
  padding: 2rem 60px;
    text-align: left;
  }

  h2 {
   color: var(--Tila_Negro_80);
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-Tila-NavBar, 'Bebas Neue', sans-serif);
      font-weight: lighter;
      letter-spacing: 0.1rem;
  }

  .testimonios-list {
       display: flex;
    justify-content: left;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .testimonios-item {
   background-color: var(--Tila_Verde_100);
    border-radius: 10px;
    padding: 3rem 1.5rem 1rem 1.5rem ;
    width: 500px;
    height: 300px;
    transition: transform 0.3s ease;
    text-align: center;
    color: var(--Tila_Blanco_100);
  }

  .testimonios-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  .testimonios-item h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 20px;
    font-family: 'BeathanyEllingston' normal;
    font-weight: lighter;
    color: var(--Tila_Negro_100);
    padding: 2rem 0rem;
  }

  .testimonios-item p {
    font-size: 16px;
    margin: 0;
    font-family: 'Futura Std', sans-serif;
    color: var(--Tila_Negro_80);

  }
</style>

<section>
  <h2>  testimonios</h2>
  <div class="testimonios-list">
    {testimonios.map(({ nombre, testimonio }) => (
      <article class="testimonios-item">
        <p>{testimonio}</p>
        <h3>{nombre}</h3>
      </article>
    ))}
  </div>
</section>
