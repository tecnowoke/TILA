---
const us = [
  {
    titulo: "Constanza Caputo",
  },
  {
    titulo: "Diana Zorzoli",
  },
  {
    titulo: "Ariel Sotof",
  }
];
---

<style>
  section {
    padding: 2rem 1rem;
    text-align: center;
  }

  h2 {
    color: var(--primary-color, #8B5E3B);
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .us-list {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .us-item {
    background-color: var(--background-color, #FAF3E0);
    border: 1px solid var(--accent-color, #A47E58);
    border-radius: 10px;
    padding: 1rem 1.5rem;
    width: 220px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .us-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  .us-item h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--secondary-color, #D9B382);
    font-size: 1.3rem;
  }

  .us-item p {
    font-size: 1rem;
    color: var(--text-color, #3E2723);
    margin: 0;
  }
</style>

<section>
  <h2>  Tila</h2>
  <div class="workshop-list">
    {us.map(({ titulo }) => (
      <article class="workshop-item" key={titulo}>
        <h3>{titulo}</h3>
      </article>
    ))}
  </div>
</section>
