---
import ButtonTila from "../components/Button.astro";

const workshops = [
  {
    titulo: "Taller de Fermento",
    descripcion: "Técnicas tradicionales de masaje ayurvédico para relajación y bienestar."
  },
  {
    titulo: "Taller de caldo de hueso",
    descripcion: "Terapia basada en puntos energéticos para equilibrar cuerpo y mente."
  }
];
---

<style>
  section {
  padding: 2rem 60px;
    text-align: left;
  }

  h2 {
   color: var(--Tila_Negro_80);
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-Tila-NavBar, 'Bebas Neue', sans-serif);
      font-weight: lighter;
      letter-spacing: 0.1rem;

  }

  .workshop-list {
      display: flex;
    justify-content: left;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .workshop-item {
  background-color: black;
    border-radius: 10px;
    padding: 3rem 1.5rem 1rem 1.5rem ;
    width: 300px;
    height: 375px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
    text-align: center;
    color: var(--Tila_Blanco_100);
  }

  .workshop-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  .workshop-item h3 {
   margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 2.5rem;
    font-family: 'BeathanyEllingston' normal;
    font-weight: lighter;
  }

  .workshop-item p {
     font-size: 0.7rem;
    margin: 0;
    font-family: 'Futura Std', sans-serif;
        font-weight: 400;
  }
</style>

<section>
  <h2>  Workshops</h2>
  <div class="workshop-list">
    {workshops.map(({ titulo, descripcion }) => (
      <article class="workshop-item">
        <h3>{titulo}</h3>
        <p>{descripcion}</p>
            <ButtonTila href="https://tila-sembrar-salud.tiendup.com/login" variant="primary">
+ INFORMACIÓN      </ButtonTila>
      </article>
    ))}
  </div>
</section>
