---
import ButtonTila from "../components/Button.astro";
import { formaciones } from "../data/formaciones";
---

<style>

section {
    padding: 2rem 60px ;
    text-align: left;

  }

  h2 {
      color: var(--Tila_Negro_80);
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-Tila-NavBar, 'Bebas Neue', sans-serif);
      font-weight: lighter;
      letter-spacing: 0.1rem;
  }

  .formaciones-list {
    display: flex;
    justify-content: left;
    gap: 2rem;
    flex-wrap: wrap;
  }
.formacion-item {
  position: relative;
  border-radius: 10px;
  width: 300px;
  height: 375px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
  text-align: center;
  color: var(--Tila_Blanco_100);
  overflow: hidden;
  background: none;
}

.formacion-item::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: var(--bg-img);
  background-size: cover;
  background-position: center;
  opacity: 0.8;
  filter: brightness(0.6) saturate(1.2);
  z-index: 0;
  border-radius: 10px;
}

.contenido-formacion {
  position: relative;
  z-index: 1;
  background: rgba(67, 66, 66, 0.4);
  border-radius: 10px;
  padding: 3rem 1.5rem 1rem 1.5rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* separa texto arriba y botón abajo */
}

.formacion-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 6px 12px rgba(93, 90, 90, 0.15);
}

.contenido-formacion > *:last-child {
  align-self: center;
}

.formacion-item h3 {
  margin-top: 0;
  margin-bottom: 0.5rem;
  font-size: 2.5rem;
  font-family: 'BeathanyEllingston', serif;
  font-weight: lighter;
  letter-spacing: 0.19em;
  transform: scaleX(0.9);
}

.formacion-item p {
text-align: start;  
font-size: 0.7rem;
  margin: 0;
  font-family: 'Futura Std', sans-serif;
  font-weight: 400;
}

</style>

<section>
  <h2>Formaciones</h2>
  <div class="formaciones-list">
    {formaciones.map(({ slug, titulo, descripcion, imagen }) => (
      <article class="formacion-item" style={`--bg-img: url('${imagen}')`}>
        <div class="contenido-formacion">
          <div class="texto-arriba">
            <h3>{titulo}</h3>
            <p>{descripcion}</p>
          </div>
          <ButtonTila href={`/formaciones/${slug}`} variant="primary">
            + INFORMACIÓN
          </ButtonTila>
        </div>
      </article>
    ))}
  </div>
</section>



