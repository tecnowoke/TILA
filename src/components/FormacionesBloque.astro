---
const formaciones = [
  {
    titulo: "Masaje Abhyanga",
    descripcion: "Técnicas tradicionales de masaje ayurvédico para relajación y bienestar."
  },
  {
    titulo: "Marma Chikitsa",
    descripcion: "Terapia basada en puntos energéticos para equilibrar cuerpo y mente."
  },
  {
    titulo: "Técnicas Avanzadas",
    descripcion: "Métodos profundizados para profesionales y practicantes avanzados."
  }
];
---

<style>
  section {
    padding: 2rem 1rem;
    text-align: center;
  }

  h2 {
    color: var(--primary-color, #8B5E3B);
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .formaciones-list {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .formacion-item {
    background-color: var(--background-color, #FAF3E0);
    border: 1px solid var(--accent-color, #A47E58);
    border-radius: 10px;
    padding: 1rem 1.5rem;
    width: 220px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .formacion-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  .formacion-item h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--secondary-color, #D9B382);
    font-size: 1.3rem;
  }

  .formacion-item p {
    font-size: 1rem;
    color: var(--text-color, #3E2723);
    margin: 0;
  }
</style>

<section>
  <h2>Formaciones</h2>
  <div class="formaciones-list">
    {formaciones.map(({ titulo, descripcion }) => (
      <article class="formacion-item">
        <h3>{titulo}</h3>
        <p>{descripcion}</p>
      </article>
    ))}
  </div>
</section>
