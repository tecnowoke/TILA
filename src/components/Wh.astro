---
const { phone = "54000000000" } = Astro.props;
const whatsappUrl = `https://wa.me/${phone}`;
import chatIcon from "../assets/vectors/Chat.svg"
---

<style>
  .whatsapp-button {
    position: fixed;
    bottom: 3rem;
    right: 3rem;
    z-index: 1000;
    background-color: var(--Tila_Blanco_100);
    border-radius: 5px;
    padding: 0.5rem;
    transition: transform 0.2s ease;
  }

  .whatsapp-button:hover {
    transform: scale(1.1);
  }

  .whatsapp-button img {
    display: block;
    width: 45px;
    height: 45px;
  }
</style>

<a
  href={whatsappUrl}
  class="whatsapp-button"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chatear por WhatsApp"
>
  <img
    src={chatIcon.src}
    alt="WhatsApp"
  />
</a>
